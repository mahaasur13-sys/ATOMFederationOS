# ATOM OS v14.2 — Environment Configuration
# Copy to .env and fill in values

# === Core ===
ATOM_MODE=production
LOG_LEVEL=info
ATOM_NODE_ID=atom-node-001

# === Security ===
POSTGRES_PASSWORD=change-me-in-production
POLICY_STRICT_MODE=true
ZERO_TRUST=true
GRAFANA_PASSWORD=atom-admin

# === Federation ===
ATOM_FEDERATION_ENABLED=false

# === Gateway ===
GATEWAY_PORT=8080
CORS_ORIGINS=*

# === Ollama ===
OLLAMA_HOST=http://ollama:11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1

# === Swarm ===
SWARM_MAX_WORKERS=8
